<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <TextView
        android:id="@+id/textViewMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_sent"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="This is a sent message that is long enough to wrap to the next line" />

    <TextView
        android:id="@+id/textViewTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textColor="#808080"
        android:textSize="10sp"
        tools:text="10:00 AM"
        app:layout_constraintBottom_toBottomOf="@+id/textViewMessage"
        app:layout_constraintEnd_toStartOf="@+id/sent_tick" />

    <ImageView
        android:id="@+id/sent_tick"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_tick"
        app:layout_constraintBottom_toBottomOf="@+id/textViewTimestamp"
        app:layout_constraintEnd_toEndOf="@+id/textViewMessage"
        app:layout_constraintTop_toTopOf="@+id/textViewTimestamp"
        android:contentDescription="Sent" />

</androidx.constraintlayout.widget.ConstraintLayout>
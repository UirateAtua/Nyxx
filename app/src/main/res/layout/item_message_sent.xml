<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Message Bubble -->
    <TextView
        android:id="@+id/textViewMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_sent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/messageSentText"
        android:textSize="15sp"
        android:maxWidth="280dp"
        tools:text="This is a sent message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Container for timestamp and ticks -->
    <LinearLayout
        android:id="@+id/timestampAndTicks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/textViewMessage"
        app:layout_constraintEnd_toEndOf="@id/textViewMessage">

        <TextView
            android:id="@+id/textViewTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            tools:text="10:00 AM"
            android:layout_marginEnd="4dp"/>

        <ImageView
            android:id="@+id/imageViewSentTick"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_tick_sent"
            android:contentDescription="Sent"
            app:tint="@color/sentTickColor" />

        <ImageView
            android:id="@+id/imageViewSeenTick"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="-6dp"
            android:src="@drawable/ic_tick_seen"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="Seen"
            app:tint="@color/seenTickColor" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>